{
  "name": "longcasting-pro",
  "version": "1.0.0",
  "description": "App professionale per tracking lanci long casting con statistiche, storico sessioni e grafici di miglioramento",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,css,html,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json}\"",
    "validate": "npm run lint && npm run format:check",
    "clean": "rm -rf dist",
    "serve": "npx serve ."
  },
  "keywords": [
    "longcasting",
    "fishing",
    "pwa",
    "gps",
    "tracking",
    "sports"
  ],
  "author": "Longcasting Pro Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
